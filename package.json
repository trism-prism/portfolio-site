{
  "name": "portfolio-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "serve out -l 4173 --no-clipboard",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:content": "vitest run src/content",
    "e2e": "playwright test",
    "check:fast": "npm run lint && npm run test:content",
    "check:quick": "npm run typecheck && npm run lint && npm test",
    "check:full": "npm run check:quick && npm run build:e2e && npm run e2e",
    "build:e2e": "node scripts/build-e2e.mjs"
  },
  "dependencies": {
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "image-size": "^2.1.0",
    "serve": "^14.2.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
