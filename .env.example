# Contact form relay (optional). Both values end up in the public JavaScript bundle by design:
# use a relay whose form endpoint/access key is meant to be public (Formspree form URL,
# Web3Forms access key). Never put a private API secret here.
# Leave empty to keep the mail-app hand-off.
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_CONTACT_ACCESS_KEY=
